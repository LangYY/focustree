# ════════════════════════════════════════════════════════════════
# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除。
# ════════════════════════════════════════════════════════════════

# ── 前端可见（VITE_ 前缀会被打包进 client bundle）──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# ── 仅服务端使用 ──
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
# 切到 OpenAI 时改成 LLM_PROVIDER=openai，并填写 OPENAI_API_KEY。
# OpenAI API 使用 API key 认证，不使用 ChatGPT/GPT OAuth token。
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_CHAT=gpt-4o-mini
# OPENAI_MODEL_REASONER=gpt-4o
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # bypass RLS，仅供 server 摘要器使用，切勿暴露到前端

# 如果本机直连 DeepSeek 被 TLS reset，可填本地 HTTP 代理，例如：
# LLM_PROXY_URL=http://127.0.0.1:1082
# LLM_TIMEOUT_MS=45000
